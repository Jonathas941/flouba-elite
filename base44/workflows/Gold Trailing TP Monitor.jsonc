{
  "name": "Gold Trailing TP Monitor",
  "description": "Monitors open positions every 5 minutes and applies trailing TP logic ($2 trigger, $1.5 distance ahead) for all connected MT5 accounts.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-07-14T00:12:29.501000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gold_trailing_tp_monitor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "trailingTpMonitor",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}