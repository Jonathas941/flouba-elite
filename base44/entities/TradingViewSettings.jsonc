{
  "name": "TradingViewSettings",
  "type": "object",
  "properties": {
    "webhook_secret": {
      "type": "string",
      "description": "Unique per-user webhook secret for authenticating TradingView alerts."
    },
    "auto_trading_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle \u2014 when OFF, no TradingView alerts are executed."
    },
    "trading_mode": {
      "type": "string",
      "enum": [
        "test",
        "live"
      ],
      "default": "test",
      "description": "test = log only, no real trades. live = execute via MT5 bridge."
    },
    "lot_size_mode": {
      "type": "string",
      "enum": [
        "alert_quantity",
        "fixed"
      ],
      "default": "alert_quantity"
    },
    "fixed_lot_size": {
      "type": "number",
      "default": 0.01
    },
    "allowed_symbols": {
      "type": "string",
      "default": "XAUUSD",
      "description": "Comma-separated list of allowed trading symbols."
    },
    "max_lot_size": {
      "type": "number",
      "default": 0.1
    },
    "max_open_trades": {
      "type": "number",
      "default": 3
    },
    "stop_loss_required": {
      "type": "boolean",
      "default": false
    },
    "take_profit_required": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}