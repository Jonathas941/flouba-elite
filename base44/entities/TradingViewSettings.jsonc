{
  "name": "TradingViewSettings",
  "type": "object",
  "properties": {
    "webhook_secret": {
      "type": "string",
      "description": "Unique per-user webhook secret for authenticating TradingView alerts."
    },
    "auto_trading_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle \u2014 when OFF, no TradingView signals are executed."
    },
    "trading_mode": {
      "type": "string",
      "enum": [
        "test",
        "live"
      ],
      "default": "test",
      "description": "test = validate and simulate only. live = execute via MT5 robot or broker API."
    },
    "execution_target": {
      "type": "string",
      "enum": [
        "auto",
        "mt5_robot",
        "broker_api"
      ],
      "default": "auto",
      "description": "auto = use MT5 robot if connected, else broker API. mt5_robot = force MT5 bridge. broker_api = force OANDA/cTrader."
    },
    "use_alert_quantity": {
      "type": "boolean",
      "default": true,
      "description": "When ON, use the quantity from the TradingView alert. When OFF, use fixed_order_size."
    },
    "fixed_order_size": {
      "type": "number",
      "default": 0.01
    },
    "max_order_size": {
      "type": "number",
      "default": 0.1,
      "description": "Hard cap \u2014 any signal exceeding this is rejected."
    },
    "allowed_symbols": {
      "type": "string",
      "default": "XAUUSD",
      "description": "Comma-separated list of allowed trading symbols."
    },
    "max_open_positions": {
      "type": "number",
      "default": 3
    },
    "allow_buy": {
      "type": "boolean",
      "default": true
    },
    "allow_sell": {
      "type": "boolean",
      "default": true
    },
    "allow_close": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}