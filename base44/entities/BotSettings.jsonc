{
  "name": "BotSettings",
  "type": "object",
  "properties": {
    "trading_mode": {
      "type": "string",
      "enum": [
        "Conservative",
        "Balanced",
        "Aggressive"
      ],
      "default": "Balanced"
    },
    "bot_mentality": {
      "type": "string",
      "enum": [
        "Basic",
        "Premium"
      ],
      "default": "Premium",
      "description": "Bot execution mentality. Basic = patient/selective/defensive; Premium = aggressive execution with controlled risk."
    },
    "lot_size_mode": {
      "type": "string",
      "enum": [
        "Fixed",
        "Auto Risk"
      ],
      "default": "Auto Risk"
    },
    "lot_size": {
      "type": "number",
      "default": 0.01
    },
    "max_concurrent_trades": {
      "type": "number",
      "default": 2,
      "description": "Max number of trades the robot may hold open at once."
    },
    "risk_percentage": {
      "type": "number",
      "default": 1
    },
    "stop_loss": {
      "type": "number",
      "default": 50
    },
    "dynamic_stop_loss": {
      "type": "boolean",
      "default": false,
      "description": "When enabled, stop loss is scaled to live ATR instead of a fixed pip value."
    },
    "atr_sl_multiplier": {
      "type": "number",
      "default": 2,
      "description": "Multiplier applied to the live ATR to compute the volatility-adjusted stop loss."
    },
    "take_profit": {
      "type": "number",
      "default": 100
    },
    "max_daily_trades": {
      "type": "number",
      "default": 999999,
      "description": "Daily trade cap removed \u2014 effectively unlimited."
    },
    "stop_after_losses": {
      "type": "number",
      "default": 2
    },
    "daily_profit_target": {
      "type": "number",
      "default": 100
    },
    "daily_loss_limit": {
      "type": "number",
      "default": 50
    },
    "max_daily_drawdown": {
      "type": "number"
    },
    "max_weekly_drawdown": {
      "type": "number"
    },
    "max_monthly_drawdown": {
      "type": "number"
    },
    "break_even": {
      "type": "boolean",
      "default": true
    },
    "trailing_stop": {
      "type": "boolean",
      "default": false
    },
    "news_filter": {
      "type": "boolean",
      "default": true
    },
    "london_session": {
      "type": "boolean",
      "default": true
    },
    "new_york_session": {
      "type": "boolean",
      "default": true
    },
    "asian_session": {
      "type": "boolean",
      "default": false
    },
    "spread_filter": {
      "type": "boolean",
      "default": true
    },
    "volatility_filter": {
      "type": "boolean",
      "default": true
    },
    "grid_distance_pips": {
      "type": "number",
      "default": 10
    },
    "grid_max_levels": {
      "type": "number",
      "default": 5
    },
    "equity_guard_enabled": {
      "type": "boolean",
      "default": true
    },
    "equity_guard_min_equity_pct": {
      "type": "number",
      "default": 50
    },
    "trend_filter_enabled": {
      "type": "boolean",
      "default": true
    },
    "trend_filter_timeframe": {
      "type": "string",
      "enum": [
        "M15",
        "H1"
      ],
      "default": "M15"
    },
    "trend_filter_ema_period": {
      "type": "number",
      "default": 200
    },
    "liq_htf_timeframe": {
      "type": "string",
      "enum": [
        "M15",
        "H1"
      ],
      "default": "M15"
    },
    "liq_entry_timeframe": {
      "type": "string",
      "enum": [
        "M1",
        "M5"
      ],
      "default": "M1"
    },
