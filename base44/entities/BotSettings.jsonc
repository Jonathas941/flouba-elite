      "type": "number",
      "default": 200
    },
    "liq_rsi_overbought": {
      "type": "number",
      "default": 80
    },
    "liq_rsi_oversold": {
      "type": "number",
      "default": 20
    },
    "liq_use_vwap": {
      "type": "boolean",
      "default": true
    },
    "liq_session_only": {
      "type": "boolean",
      "default": true
    },
    "liq_news_buffer_minutes": {
      "type": "number",
      "default": 10
    },
    "lot_multiplier": {
      "type": "number",
      "default": 2
    },
    "multiplier_min_equity_ratio": {
      "type": "number",
      "default": 2
    },
    "auto_multiplier_enabled": {
      "type": "boolean",
      "default": false
    },
    "auto_start_enabled": {
      "type": "boolean",
      "default": false
    },
    "auto_start_time": {
      "type": "string",
      "default": "09:00"
    },
    "auto_stop_enabled": {
      "type": "boolean",
      "default": true
    },
    "hedge_scalp_tp_pips": {
      "type": "number",
      "default": 30
    },
    "hedge_scalp_sl_pips": {
      "type": "number",
      "default": 15
    },
    "hedge_scalp_lot_size": {
      "type": "number",
      "default": 0.02
    },
    "hedge_scalp_max_pairs": {
      "type": "number",
      "default": 3
    },
    "hedge_scalp_close_winner_on_sl": {
      "type": "boolean",
      "default": true
    },
    "hedge_scalp_reopen_delay_sec": {
      "type": "number",
      "default": 5
    },
    "hedge_scalp_trend_entry": {
      "type": "boolean",
      "default": true
    },
    "hedge_scalp_trend_timeframe": {
      "type": "string",
      "enum": [
        "M15",
        "H1"
      ],
      "default": "M15"
    },
    "hedge_scalp_trend_ema_period": {
      "type": "number",
      "default": 200
    },
    "hedge_scalp_hedge_mode": {
      "type": "string",
      "enum": [
        "Same Pair",
        "Cross Pair",
        "Both"
      ],
      "default": "Same Pair"
    },
    "hedge_scalp_hedge_trigger_pips": {
      "type": "number",
      "default": 15
    },
    "hedge_scalp_scalp_over_hedge": {
      "type": "boolean",
      "default": true
    },
    "hedge_scalp_scalp_tp_pips": {
      "type": "number",
      "default": 5
    },
    "hedge_scalp_drawdown_reduction": {
      "type": "boolean",
      "default": true
    },
    "hedge_scalp_dd_close_ratio": {
      "type": "number",
      "default": 1
    },
    "hedge_scalp_pair_priority": {
      "type": "boolean",
      "default": true
    },
    "hedge_scalp_priority_lookback_trades": {
      "type": "number",
      "default": 20
    },
    "swing_timeframe": {
      "type": "string",
      "enum": [
        "M15",
        "M30",
        "H1"
      ],
      "default": "M15"
    },
    "swing_ema_fast": {
      "type": "number",
      "default": 20
    },
    "swing_ema_slow": {
      "type": "number",
      "default": 50
    },
    "swing_atr_period": {
      "type": "number",
      "default": 14
    },
    "swing_atr_sl_multiplier": {
      "type": "number",
      "default": 1.5
    },
    "swing_min_rr": {
      "type": "number",
      "default": 2
    },
    "swing_lot_size": {
      "type": "number",
      "default": 0.01
    },
    "swing_max_open_trades": {
      "type": "number",
      "default": 2
    },
    "swing_max_trades_per_day": {
      "type": "number",
      "default": 3
    },
    "swing_max_consecutive_losses": {
      "type": "number",
      "default": 2
    },
    "swing_cooldown_hours": {
      "type": "number",
      "default": 8
    },
    "swing_max_daily_loss_pct": {
      "type": "number",
      "default": 40
    },
    "swing_max_daily_drawdown_pct": {
      "type": "number",
      "default": 3
    },
    "swing_max_spread_points": {
      "type": "number",
      "default": 30
    },
    "swing_use_break_even": {
      "type": "boolean",
      "default": true
    },
    "swing_be_at_r": {
      "type": "number",
      "default": 1
    },
    "swing_use_trailing": {
      "type": "boolean",
      "default": false
    },
    "swing_trailing_atr_mult": {
      "type": "number",
      "default": 1.5
    },
    "swing_pullback_zone_atr": {
      "type": "number",
      "default": 0.25
    },
    "swing_block_deep_pullback": {
      "type": "boolean",
      "default": true
    },
    "swing_partial_close_50": {
      "type": "boolean",
      "default": true
    },
    "tpr_ema_fast": {
      "type": "number",
      "default": 6,
      "description": "EMA Trend Progressive Recovery \u2014 fast EMA period."
    },
    "tpr_ema_slow": {
      "type": "number",
      "default": 25,
      "description": "EMA Trend Progressive Recovery \u2014 slow EMA period."
    },
    "tpr_atr_period": {
      "type": "number",
      "default": 14,
      "description": "EMA Trend Progressive Recovery \u2014 ATR period."
    },
    "tpr_min_ema_distance": {
      "type": "number",
      "default": 0,
      "description": "EMA Trend Progressive Recovery \u2014 minimum distance between EMA fast and slow (price units) before the trend is considered strong."
    },
    "tpr_trend_strength": {
      "type": "number",
      "default": 0,
      "description": "EMA Trend Progressive Recovery \u2014 minimum EMA slope threshold to confirm trend strength."
    },
    "tpr_lot_size": {
      "type": "number",
      "default": 0.01,
      "description": "EMA Trend Progressive Recovery \u2014 default lot size."
    },
    "tpr_max_open_positions": {
      "type": "number",
      "default": 2,
      "description": "EMA Trend Progressive Recovery \u2014 maximum total open positions (initial + recovery)."
    },
    "tpr_max_recovery_positions": {
      "type": "number",
      "default": 1,
      "description": "EMA Trend Progressive Recovery \u2014 maximum recovery positions added to an initial trade."
    },
    "tpr_lot_multiplier": {
      "type": "number",
      "default": 1,
      "description": "EMA Trend Progressive Recovery \u2014 lot multiplier for recovery positions (capped by tpr_max_lot_multiplier)."
    },
    "tpr_max_lot_multiplier": {
      "type": "number",
      "default": 1.25,
      "description": "EMA Trend Progressive Recovery \u2014 hard cap on the recovery lot multiplier. Never exceeded."
    },
    "tpr_recovery_atr_mult": {
      "type": "number",
      "default": 1.2,
      "description": "EMA Trend Progressive Recovery \u2014 adverse distance (\u00d7ATR) the price must move before a recovery position is allowed."
    },
    "tpr_basket_profit_target": {
      "type": "number",
      "default": 10,
      "description": "EMA Trend Progressive Recovery \u2014 basket floating profit target ($) that closes all positions together."
    },
    "tpr_emergency_sl_atr": {
      "type": "number",
      "default": 1.8,
      "description": "EMA Trend Progressive Recovery \u2014 emergency stop loss distance (\u00d7ATR) from entry."
    },
    "tpr_equity_stop_pct": {
      "type": "number",
      "default": 3,
      "description": "EMA Trend Progressive Recovery \u2014 equity stop loss as a percentage of balance."
    },
    "tpr_daily_loss_limit_pct": {
      "type": "number",
      "default": 40,
      "description": "EMA Trend Progressive Recovery \u2014 daily loss limit as a percentage of balance."
    },
    "tpr_max_trades_per_day": {
      "type": "number",
      "default": 3
    },
    "tpr_max_consecutive_losses": {
      "type": "number",
      "default": 2
    },
    "tpr_cooldown_hours": {
      "type": "number",
      "default": 8
    },
    "tpr_use_break_even": {
      "type": "boolean",
      "default": true
    },
    "tpr_partial_close_50": {
      "type": "boolean",
      "default": true
    },
    "tpr_min_rr": {
      "type": "number",
      "default": 2
    },
    "tpr_max_spread_points": {
      "type": "number",
      "default": 30
    },
    "hybrid_timeframe": {
      "type": "string",
      "enum": [
        "M5",
        "M15",
        "M30",
        "H1"
      ],
      "default": "M15",
      "description": "Hybrid Confluence Mode \u2014 chart timeframe used across all layers."
    },
    "hybrid_ema_6": {
      "type": "number",
      "default": 6,
      "description": "Hybrid Confluence Mode \u2014 fast EMA period."
    },
    "hybrid_ema_20": {
      "type": "number",
      "default": 20,
      "description": "Hybrid Confluence Mode \u2014 pullback EMA period."
    },
