      "type": "string",
      "enum": [
        "Fixed",
        "Auto"
      ],
      "default": "Fixed",
      "description": "Fixed = use daily_profit_target_amount; Auto = bot dynamically sets the session target from market conditions (regime, volatility, balance)."
    },
    "daily_profit_target_amount": {
      "type": "number",
      "default": 200
    },
    "session_cooldown_minutes": {
      "type": "number",
      "default": 60,
