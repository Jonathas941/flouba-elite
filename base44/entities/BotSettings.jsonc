{
  "name": "BotSettings",
  "type": "object",
  "properties": {
    "trading_mode": {
      "type": "string",
      "enum": [
        "Conservative",
        "Normal",
        "Aggressive"
      ],
      "default": "Normal"
    },
    "lot_size_mode": {
      "type": "string",
      "enum": [
        "Fixed",
        "Auto Risk"
      ],
      "default": "Auto Risk"
    },
    "risk_percentage": {
      "type": "number",
      "default": 1
    },
    "max_daily_trades": {
      "type": "number",
      "default": 5
    },
    "daily_profit_target": {
      "type": "number",
      "default": 100
    },
    "daily_loss_limit": {
      "type": "number",
      "default": 50
    },
    "break_even": {
      "type": "boolean",
      "default": true
    },
    "trailing_stop": {
      "type": "boolean",
      "default": false
    },
    "news_filter": {
      "type": "boolean",
      "default": true
    },
    "london_session": {
      "type": "boolean",
      "default": true
    },
    "new_york_session": {
      "type": "boolean",
      "default": true
    },
    "asian_session": {
      "type": "boolean",
      "default": false
    },
    "partial_close": {
      "type": "boolean",
      "default": false
    },
    "max_spread": {
      "type": "number",
      "default": 3
    },
    "slippage": {
      "type": "number",
      "default": 2
    },
    "max_positions": {
      "type": "number",
      "default": 3
    },
    "risk_reward_ratio": {
      "type": "number",
      "default": 2
    },
    "max_hold_hours": {
      "type": "number",
      "default": 24
    },
    "robot_status": {
      "type": "string",
      "enum": [
        "Running",
        "Waiting for Confirmation",
        "Scanning Market",
        "Entering Trade",
        "Managing Position",
        "Paused",
        "Locked"
      ],
      "default": "Paused"
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "Connected",
        "Disconnected"
      ],
      "default": "Disconnected"
    },
    "active_pair": {
      "type": "string",
      "enum": [
        "XAUUSD",
        "EURUSD",
        "GBPUSD",
        "USDJPY",
        "NAS100",
        "US30"
      ],
      "default": "XAUUSD"
    },
    "mt5_account": {
      "type": "string"
    },
    "mt5_server": {
      "type": "string"
    },
    "broker_name": {
      "type": "string"
    },
    "robot_version": {
      "type": "string"
    },
    "balance": {
      "type": "number"
    },
    "equity": {
      "type": "number"
    },
    "margin": {
      "type": "number"
    },
    "free_margin": {
      "type": "number"
    },
    "profit_today": {
      "type": "number"
    },
    "daily_drawdown": {
      "type": "number"
    },
    "win_rate": {
      "type": "number"
    },
    "total_trades": {
      "type": "number"
    }
  },
  "required": []
}