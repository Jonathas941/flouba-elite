{
  "name": "BotSettings",
  "type": "object",
  "properties": {
    "trading_mode": {
      "type": "string",
      "enum": [
        "Conservative",
        "Balanced",
        "Aggressive"
      ],
      "default": "Balanced"
    },
    "lot_size_mode": {
      "type": "string",
      "enum": [
        "Fixed",
        "Auto Risk"
      ],
      "default": "Auto Risk"
    },
    "lot_size": {
      "type": "number",
      "default": 0.01
    },
    "max_concurrent_trades": {
      "type": "number",
      "default": 2,
      "description": "Max number of trades the robot may hold open at once. Scales with trading_mode (Conservative=1, Balanced=2, Aggressive=5)."
    },
    "risk_percentage": {
      "type": "number",
      "default": 1
    },
    "stop_loss": {
      "type": "number",
      "default": 50
    },
    "take_profit": {
      "type": "number",
      "default": 100
    },
    "max_daily_trades": {
      "type": "number",
      "default": 999999,
      "description": "Daily trade cap removed \u2014 effectively unlimited."
    },
    "stop_after_losses": {
      "type": "number",
      "default": 2
    },
    "daily_profit_target": {
      "type": "number",
      "default": 100
    },
    "daily_loss_limit": {
      "type": "number",
      "default": 50
    },
    "max_daily_drawdown": {
      "type": "number"
    },
    "max_weekly_drawdown": {
      "type": "number"
    },
    "max_monthly_drawdown": {
      "type": "number"
    },
    "break_even": {
      "type": "boolean",
      "default": true
    },
    "trailing_stop": {
      "type": "boolean",
      "default": false
    },
    "news_filter": {
      "type": "boolean",
      "default": true
    },
    "london_session": {
      "type": "boolean",
      "default": true
    },
    "new_york_session": {
      "type": "boolean",
      "default": true
    },
    "asian_session": {
      "type": "boolean",
      "default": false
    },
    "spread_filter": {
      "type": "boolean",
      "default": true
    },
    "volatility_filter": {
      "type": "boolean",
      "default": true
    },
    "grid_distance_pips": {
      "type": "number",
      "default": 10,
      "description": "Distance in pips between grid levels for the Grid Trading strategy."
    },
    "grid_max_levels": {
      "type": "number",
      "default": 5,
      "description": "Maximum number of grid levels (stacked positions) the Grid Trading strategy may open."
    },
    "equity_guard_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Hard-stop protection: closes all positions and pauses the robot if equity falls below the configured % of balance."
    },
    "equity_guard_min_equity_pct": {
      "type": "number",
      "default": 50,
      "description": "Minimum equity as a percentage of balance before the Equity Guard force-closes all trades and pauses the robot."
    },
    "robot_status": {
      "type": "string",
      "enum": [
        "Running",
        "Waiting for Confirmation",
        "Scanning Market",
        "Entering Trade",
        "Managing Position",
        "Signal Found",
        "Sending Order",
        "Trade Opened",
        "No Valid Signal Yet",
        "Paused",
        "Locked"
      ],
      "default": "Paused"
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "Connected",
        "Disconnected"
      ],
      "default": "Disconnected"
    },
    "active_pair": {
      "type": "string",
      "enum": [
        "XAUUSD",
        "EURUSD",
        "GBPUSD",
        "USDJPY",
        "NAS100",
        "US30",
        "BTCUSD"
      ],
      "default": "XAUUSD"
    },
    "mt5_account": {
      "type": "string"
    },
    "mt5_server": {
      "type": "string"
    },
    "broker_name": {
      "type": "string"
    },
    "robot_version": {
      "type": "string"
    },
    "balance": {
      "type": "number"
    },
    "equity": {
      "type": "number"
    },
    "margin": {
      "type": "number"
    },
    "free_margin": {
      "type": "number"
    },
    "profit_today": {
      "type": "number"
    },
    "daily_drawdown": {
      "type": "number"
    },
    "win_rate": {
      "type": "number"
    },
    "total_trades": {
      "type": "number"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}