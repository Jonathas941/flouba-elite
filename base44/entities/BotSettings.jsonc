{
  "name": "BotSettings",
  "type": "object",
  "properties": {
    "trading_mode": {
      "type": "string",
      "enum": [
        "Conservative",
        "Balanced",
        "Aggressive"
      ],
      "default": "Balanced"
    },
    "lot_size_mode": {
      "type": "string",
      "enum": [
        "Fixed",
        "Auto Risk"
      ],
      "default": "Auto Risk"
    },
    "lot_size": {
      "type": "number",
      "default": 0.01
    },
    "max_concurrent_trades": {
      "type": "number",
      "default": 2,
      "description": "Max number of trades the robot may hold open at once."
    },
    "risk_percentage": {
      "type": "number",
      "default": 1
    },
    "stop_loss": {
      "type": "number",
      "default": 50
    },
    "dynamic_stop_loss": {
      "type": "boolean",
      "default": false,
      "description": "When enabled, stop loss is scaled to live ATR instead of a fixed pip value."
    },
    "atr_sl_multiplier": {
      "type": "number",
      "default": 2,
      "description": "Multiplier applied to the live ATR to compute the volatility-adjusted stop loss."
    },
    "take_profit": {
      "type": "number",
      "default": 100
    },
    "max_daily_trades": {
      "type": "number",
      "default": 999999,
      "description": "Daily trade cap removed \u2014 effectively unlimited."
    },
    "stop_after_losses": {
      "type": "number",
      "default": 2
    },
    "daily_profit_target": {
      "type": "number",
      "default": 100
    },
    "daily_loss_limit": {
      "type": "number",
      "default": 50
    },
    "max_daily_drawdown": {
      "type": "number"
    },
    "max_weekly_drawdown": {
      "type": "number"
    },
    "max_monthly_drawdown": {
      "type": "number"
    },
    "break_even": {
      "type": "boolean",
      "default": true
    },
    "trailing_stop": {
      "type": "boolean",
      "default": false
    },
    "news_filter": {
      "type": "boolean",
      "default": true
    },
    "london_session": {
      "type": "boolean",
      "default": true
    },
    "new_york_session": {
      "type": "boolean",
      "default": true
    },
    "asian_session": {
      "type": "boolean",
      "default": false
    },
    "spread_filter": {
      "type": "boolean",
      "default": true
    },
    "volatility_filter": {
      "type": "boolean",
      "default": true
    },
    "grid_distance_pips": {
      "type": "number",
      "default": 10,
      "description": "Distance in pips between grid levels for the Grid Trading strategy."
    },
    "grid_max_levels": {
      "type": "number",
      "default": 5,
      "description": "Maximum number of grid levels (stacked positions) the Grid Trading strategy may open."
    },
    "equity_guard_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Hard-stop protection: closes all positions and pauses the robot if equity falls below the configured % of balance."
    },
    "equity_guard_min_equity_pct": {
      "type": "number",
      "default": 50,
      "description": "Minimum equity as a percentage of balance before the Equity Guard force-closes all trades and pauses the robot."
    },
    "trend_filter_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Global HTF trend filter: only allows Buy when price is above the HTF 200 EMA, and Sell when below it."
    },
    "trend_filter_timeframe": {
      "type": "string",
      "enum": [
        "M15",
        "H1"
      ],
      "default": "M15"
    },
    "trend_filter_ema_period": {
      "type": "number",
      "default": 200
    },
    "liq_htf_timeframe": {
      "type": "string",
      "enum": [
        "M15",
        "H1"
      ],
      "default": "M15"
    },
    "liq_entry_timeframe": {
      "type": "string",
      "enum": [
        "M1",
        "M5"
      ],
      "default": "M1"
    },
    "liq_htf_ema_period": {
      "type": "number",
      "default": 200
    },
    "liq_rsi_overbought": {
      "type": "number",
      "default": 80
    },
    "liq_rsi_oversold": {
      "type": "number",
      "default": 20
    },
    "liq_use_vwap": {
      "type": "boolean",
      "default": true
    },
    "liq_session_only": {
      "type": "boolean",
      "default": true
    },
    "liq_news_buffer_minutes": {
      "type": "number",
      "default": 10
    },
    "lot_multiplier": {
      "type": "number",
      "default": 2,
      "description": "Lot size multiplier applied to consecutive winning entries for compounding growth."
    },
    "multiplier_min_equity_ratio": {
      "type": "number",
      "default": 2,
      "description": "Equity-to-balance ratio required before the lot multiplier activates. When equity reaches this multiple of balance (e.g. 2x), compounding kicks in. Below this, lot_multiplier is forced to 1 (flat)."
    },
    "auto_multiplier_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When enabled, the lot multiplier is set automatically based on live trade performance: requires 30+ closed trades, 55%+ win rate, net positive P&L, and equity \u2265 2x balance before compounding activates. Otherwise stays flat (1x)."
    },
    "auto_start_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When enabled, the robot auto-starts at the configured time each day (America/Detroit timezone)."
    },
    "auto_start_time": {
      "type": "string",
      "default": "09:00",
      "description": "Daily auto-start time in HH:MM format (America/Detroit local time)."
    },
    "auto_stop_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When enabled, auto-stops the robot when daily profit target or loss limit is reached."
    },
    "hedge_scalp_tp_pips": {
      "type": "number",
      "default": 30
    },
    "hedge_scalp_sl_pips": {
      "type": "number",
      "default": 15
    },
    "hedge_scalp_lot_size": {
      "type": "number",
      "default": 0.02
    },
    "hedge_scalp_max_pairs": {
      "type": "number",
      "default": 3
    },
    "hedge_scalp_close_winner_on_sl": {
      "type": "boolean",
      "default": true
    },
    "hedge_scalp_reopen_delay_sec": {
      "type": "number",
      "default": 5
    },
    "hedge_scalp_trend_entry": {
      "type": "boolean",
      "default": true
    },
    "hedge_scalp_trend_timeframe": {
      "type": "string",
      "enum": [
        "M15",
        "H1"
      ],
      "default": "M15"
    },
    "hedge_scalp_trend_ema_period": {
      "type": "number",
      "default": 200
    },
    "hedge_scalp_hedge_mode": {
      "type": "string",
      "enum": [
        "Same Pair",
        "Cross Pair",
        "Both"
      ],
      "default": "Same Pair"
    },
    "hedge_scalp_hedge_trigger_pips": {
      "type": "number",
      "default": 15
    },
    "hedge_scalp_scalp_over_hedge": {
      "type": "boolean",
      "default": true
    },
    "hedge_scalp_scalp_tp_pips": {
      "type": "number",
      "default": 5
    },
    "hedge_scalp_drawdown_reduction": {
      "type": "boolean",
      "default": true
    },
    "hedge_scalp_dd_close_ratio": {
      "type": "number",
      "default": 1
    },
    "hedge_scalp_pair_priority": {
      "type": "boolean",
      "default": true
    },
    "hedge_scalp_priority_lookback_trades": {
      "type": "number",
      "default": 20
    },
    "robot_status": {
      "type": "string",
      "enum": [
        "Running",
        "Waiting for Confirmation",
        "Scanning Market",
        "Entering Trade",
        "Managing Position",
        "Signal Found",
        "Sending Order",
        "Trade Opened",
        "No Valid Signal Yet",
        "Paused",
        "Locked"
      ],
      "default": "Paused"
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "Connected",
        "Disconnected"
      ],
      "default": "Disconnected"
    },
    "active_pair": {
      "type": "string",
      "enum": [
        "XAUUSD",
        "EURUSD",
        "GBPUSD",
        "USDJPY",
        "NAS100",
        "US30",
        "BTCUSD"
      ],
      "default": "XAUUSD"
    },
    "mt5_account": {
      "type": "string"
    },
    "mt5_password": {
      "type": "string"
    },
    "mt5_server": {
      "type": "string"
    },
    "broker_name": {
      "type": "string"
    },
    "robot_version": {
      "type": "string"
    },
    "balance": {
      "type": "number"
    },
    "equity": {
      "type": "number"
    },
    "margin": {
      "type": "number"
    },
    "free_margin": {
      "type": "number"
    },
    "profit_today": {
      "type": "number"
    },
    "daily_drawdown": {
      "type": "number"
    },
    "win_rate": {
      "type": "number"
    },
    "total_trades": {
      "type": "number"
    },
    "ea_sent": {
      "type": "boolean",
      "default": false,
      "description": "Tracks whether the EA installation file has already been emailed to the user. Sent once on first successful MT5 connection; not resent on subsequent connections."
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}