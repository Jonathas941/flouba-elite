      "description": "Hybrid Confluence Mode — maximum controlled recovery positions."
    },
    "hybrid_lot_multiplier": {
      "type": "number",
      "default": 1,
      "description": "Hybrid Confluence Mode — recovery lot multiplier (capped by hybrid_max_lot_multiplier)."
    },
    "hybrid_max_lot_multiplier": {
      "type": "number",
      "default": 1.25,
      "description": "Hybrid Confluence Mode — hard cap on the recovery lot multiplier."
    },
    "hybrid_recovery_atr_mult": {
      "type": "number",
      "default": 1.2,
      "description": "Hybrid Confluence Mode — adverse ATR distance before a recovery position is allowed."
    },
    "hybrid_sl_atr_min": {
      "type": "number",
      "default": 1.5,
      "description": "Hybrid Confluence Mode — minimum ATR multiplier for the initial stop loss (beyond sweep wick)."
