      "type": "number",
      "default": 0.5,
      "description": "Hybrid Confluence Mode — max ATR depth price may close beyond EMA 50 before pullback is invalidated."
    },
    "hybrid_swing_lookback": {
      "type": "number",
      "default": 20,
      "description": "Hybrid Confluence Mode — bars to look back for confirmed swing high/low."
    },
    "hybrid_require_engulfing": {
      "type": "boolean",
      "default": true,
      "description": "Hybrid Confluence Mode — require a bullish/bearish engulfing candle after the sweep."
    },
    "hybrid_lot_size": {
      "type": "number",
      "default": 0.01,
      "description": "Hybrid Confluence Mode — default lot size."
    },
    "hybrid_max_positions": {
      "type": "number",
      "default": 2,
