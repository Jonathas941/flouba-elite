{
  "name": "SignalAssistantSettings",
  "type": "object",
  "properties": {
    "execution_mode": {
      "type": "string",
      "enum": [
        "signal_only",
        "semi_auto",
        "full_auto"
      ],
      "default": "signal_only",
      "description": "Signal Only = display only; Semi-Auto = user confirms; Full Auto = auto-execute at entry trigger."
    },
    "show_signals_on_chart": {
      "type": "boolean",
      "default": true
    },
    "auto_trading_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle \u2014 when OFF, the bot never places trades automatically regardless of mode."
    },
    "manual_execution_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Allows the user to manually place trades from displayed signals."
    },
    "virtual_trigger_mode": {
      "type": "boolean",
      "default": true,
      "description": "Monitors live price and executes when ask/bid reaches the entry level."
    },
    "broker_pending_order_mode": {
      "type": "boolean",
      "default": false,
      "description": "Places a real MT5 pending order (Buy Stop/Limit, Sell Stop/Limit) immediately."
    },
    "draw_entry_sl_tp_lines": {
      "type": "boolean",
      "default": true
    },
    "draw_direction_arrows": {
      "type": "boolean",
      "default": true
    },
    "show_expiration_timer": {
      "type": "boolean",
      "default": true
    },
    "cancel_expired_signals": {
      "type": "boolean",
      "default": true
    },
    "signal_expiration_minutes": {
      "type": "number",
      "default": 30,
      "description": "How long a signal stays valid before expiring."
    },
    "magic_number": {
      "type": "number",
      "default": 20260001
    },
    "trade_comment": {
      "type": "string",
      "default": "Flouba Gold HFT"
    },
    "min_confidence_score": {
      "type": "number",
      "default": 70,
      "description": "Minimum AI confluence score required to generate a signal."
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}