{
  "name": "Trade",
  "type": "object",
  "properties": {
    "pair": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "Buy",
        "Sell"
      ]
    },
    "lot": {
      "type": "number"
    },
    "profit": {
      "type": "number"
    },
    "pattern": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Closed"
      ],
      "default": "Open"
    },
    "entry_price": {
      "type": "number"
    },
    "current_price": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "take_profit": {
      "type": "number"
    },
    "spread": {
      "type": "number"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "break_even_activated": {
      "type": "boolean",
      "default": false
    },
    "partial_closed": {
      "type": "boolean",
      "default": false
    },
    "close_reason": {
      "type": "string",
      "enum": [
        "Take Profit",
        "Stop Loss",
        "Daily Target",
        "Daily Loss Limit",
        "Panic",
        "Manual",
        "Opposite Signal"
      ]
    },
    "ticket_id": {
      "type": "string"
    }
  },
  "required": [
    "pair",
    "direction"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}