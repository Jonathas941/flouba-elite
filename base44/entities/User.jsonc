{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "mt5_api_key": {
      "type": "string",
      "description": "API key returned by the MT5 server after account provisioning. Used to authenticate the user's MT5 EA with the bridge. Only the owner and admins can read this."
    },
    "mt5_slug": {
      "type": "string",
      "description": "Account identifier/slug returned by the MT5 server during provisioning."
    },
    "flouba_token": {
      "type": "string",
      "description": "Legacy JWT \u2014 no longer used by the bridge (replaced by X-Api-Key). Kept for backward compatibility. Only the owner and admins can read this."
    },
    "flouba_slug": {
      "type": "string",
      "description": "Human-readable account slug from provisioning (e.g. flouballc_4dec27). Used for admin display."
    },
    "ea_download_url": {
      "type": "string",
      "description": "Download URL for the MT5 Expert Advisor file, shown to the user so they can install it in MetaTrader. Only the owner and admins can read this."
    }
  },
  "required": [
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}