{
  "name": "TradingViewSignal",
  "type": "object",
  "properties": {
    "alert_id": {
      "type": "string",
      "description": "Unique alert ID from TradingView (used for dedup)."
    },
    "symbol": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL",
        "CLOSE",
        "CLOSE_BUY",
        "CLOSE_SELL"
      ]
    },
    "quantity": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "position_size": {
      "type": "number",
      "description": "TradingView strategy_position_size value at alert time."
    },
    "sl": {
      "type": "number",
      "description": "Stop loss price from the TradingView alert."
    },
    "tp1": {
      "type": "number",
      "description": "Take profit target 1 from the TradingView alert."
    },
    "tp2": {
      "type": "number",
      "description": "Take profit target 2 from the TradingView alert."
    },
    "tp3": {
      "type": "number",
      "description": "Take profit target 3 from the TradingView alert."
    },
    "total_lot": {
      "type": "number",
      "description": "Base44-calculated total lot size across all 3 legs."
    },
    "legs": {
      "type": "object",
      "additionalProperties": true,
      "description": "Per-leg execution details: [{lot, tp, status, order_id, error}, ...]"
    },
    "mode": {
      "type": "string",
      "enum": [
        "test",
        "live"
      ],
      "default": "test"
    },
    "status": {
      "type": "string",
      "enum": [
        "Received",
        "Validated",
        "Executed",
        "Rejected",
        "Duplicate",
        "Error",
        "Simulated",
        "Partial"
      ],
      "default": "Received"
    },
    "order_id": {
      "type": "string",
      "description": "Order ID returned by the execution API once executed."
    },
    "message": {
      "type": "string",
      "description": "Human-readable status or error message."
    },
    "raw_payload": {
      "type": "object",
      "additionalProperties": true,
      "description": "Full raw JSON payload from TradingView. Secret is stripped before saving."
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "alert_id",
    "symbol",
    "action"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}