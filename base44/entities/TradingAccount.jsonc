{
  "name": "TradingAccount",
  "type": "object",
  "properties": {
    "account_number": {
      "type": "string",
      "description": "MT5 login / account number."
    },
    "broker_name": {
      "type": "string"
    },
    "server": {
      "type": "string",
      "description": "MT5 server name (e.g. Exness-MT5Real8)."
    },
    "password": {
      "type": "string",
      "description": "MT5 account password (encrypted at rest)."
    },
    "nickname": {
      "type": "string",
      "description": "Optional friendly label shown in the switcher (e.g. 'Gold Live', 'Prop Challenge')."
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the currently selected account in the dashboard switcher."
    }
  },
  "required": [
    "account_number",
    "server"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}