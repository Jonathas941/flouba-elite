{
  "name": "MT5Account",
  "type": "object",
  "properties": {
    "account_number": {
      "type": "string"
    },
    "broker": {
      "type": "string"
    },
    "server": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Live",
        "Demo"
      ],
      "default": "Live"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "account_number"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}