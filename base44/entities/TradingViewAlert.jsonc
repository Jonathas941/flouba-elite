{
  "name": "TradingViewAlert",
  "type": "object",
  "properties": {
    "alert_id": {
      "type": "string",
      "description": "Unique alert ID from TradingView (used for dedup)."
    },
    "symbol": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL",
        "CLOSE",
        "CLOSE_BUY",
        "CLOSE_SELL"
      ]
    },
    "requested_quantity": {
      "type": "number"
    },
    "executed_quantity": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "take_profit": {
      "type": "number"
    },
    "strategy_position": {
      "type": "number",
      "description": "TradingView strategy_position_size value at alert time."
    },
    "mode": {
      "type": "string",
      "enum": [
        "test",
        "live"
      ],
      "default": "test"
    },
    "status": {
      "type": "string",
      "enum": [
        "Received",
        "Executed",
        "Rejected",
        "Duplicate",
        "Error"
      ],
      "default": "Received"
    },
    "mt5_ticket": {
      "type": "string",
      "description": "MT5 ticket number once executed."
    },
    "message": {
      "type": "string",
      "description": "Human-readable status or error message."
    },
    "raw_payload": {
      "type": "object",
      "additionalProperties": true,
      "description": "Full raw JSON payload from TradingView. Protected \u2014 never exposed with secrets."
    }
  },
  "required": [
    "alert_id",
    "symbol",
    "action"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}